import PakFixedPolyomino.FiniteOneTapeProgram
import PakFixedPolyomino.PakCouplingGenerated
import Mathlib.Tactic

/-!
# Executable outer shell of `M_star`

This file implements clauses M1, M2, and the literal embedding of M5 from the
accepted source-machine construction.  Parser/copy control is isolated as one
deterministic rule function.  Once that function is supplied, the complete
arrow alphabet is generated by `FiniteOneTapeProgram.Arrow`; it is not an
additional certificate parameter at tableau or coupling level.
-/

namespace PakFixedPolyomino.MStarOuterProgram

open OneTapeTableau FiniteOneTapeProgram

inductive State (ParserState UState : Type*) where
  | start
  | accept
  | reject
  | parser : ParserState → State ParserState UState
  | sim : UState → State ParserState UState
  deriving DecidableEq, Fintype, Repr

inductive Tape (UTape : Type*) where
  | core : UTape → Tape UTape
  | hash
  | markL
  | markR
  | scratch : Fin 8 → Tape UTape
  deriving DecidableEq, Fintype, Repr

variable {ParserState UState UTape : Type*}
variable [Fintype ParserState] [Fintype UState] [Fintype UTape]
variable [DecidableEq ParserState] [DecidableEq UState] [DecidableEq UTape]

/-- All choices not fixed by M1/M2/M5 are concentrated here.  In the final
machine `parserStep` must be the executable implementation of M3/M4, and its
correctness theorem must establish unique parse/copy behaviour. -/
structure Data where
  uProgram : Program UState UTape
  uAccept : UState
  uReject : UState
  uStart : UState
  parserStart : ParserState
  zero : UTape
  one : UTape
  work : UTape
  parserStep : ParserState → Tape UTape →
    Option (Action (State ParserState UState) (Tape UTape))

def mapUState (D : Data (ParserState := ParserState) (UState := UState)
    (UTape := UTape)) : UState → State ParserState UState := fun q =>
  if q = D.uAccept then .accept
  else if q = D.uReject then .reject
  else .sim q

def mapUAction (D : Data (ParserState := ParserState) (UState := UState)
    (UTape := UTape)) (a : Action UState UTape) :
    Action (State ParserState UState) (Tape UTape) :=
  { write := .core a.write
    target := mapUState D a.target
    move := a.move }

def isInitialLetter (D : Data (ParserState := ParserState) (UState := UState)
    (UTape := UTape)) (a : UTape) : Bool :=
  decide (a = D.zero ∨ a = D.one ∨ a = D.work)

/-- M1, M2, deterministic M3/M4, and the verbatim M5 simulation inventory. -/
def program (D : Data (ParserState := ParserState) (UState := UState)
    (UTape := UTape)) : Program (State ParserState UState) (Tape UTape) where
  rule q x i :=
    match q, x with
    | .start, .core a =>
        if isInitialLetter D a then
          if i = 0 then some
            { write := .core a, target := .accept, move := .stay }
          else some
            { write := .core a, target := .parser D.parserStart, move := .stay }
        else none
    | .accept, .hash => none
    | .accept, a =>
        if i = 0 then some { write := a, target := .accept, move := .stay } else none
    | .reject, .hash => none
    | .reject, a =>
        if i = 0 then some { write := a, target := .reject, move := .stay } else none
    | .parser p, a =>
        if i = 0 then D.parserStep p a else none
    | .sim q, .core a =>
        (D.uProgram.rule q a i).map (mapUAction D)
    | _, _ => none

abbrev Arrow (D : Data (ParserState := ParserState) (UState := UState)
    (UTape := UTape)) := FiniteOneTapeProgram.Arrow (program D)

def transition (D : Data (ParserState := ParserState) (UState := UState)
    (UTape := UTape)) : Arrow D →
    Transition (State ParserState UState) (Tape UTape) :=
  FiniteOneTapeProgram.transition (program D)

/-- Only the four physical sentinel cells are immovable.  Delimiters are
ordinary tape letters; the parser/copy program controls whether they may be
crossed. -/
def movable : Tape UTape → Bool
  | .hash => false
  | _ => true

def tableauData (D : Data (ParserState := ParserState) (UState := UState)
    (UTape := UTape)) :
    TableauMachineData (State ParserState UState) (Tape UTape) (Arrow D) :=
  FiniteOneTapeProgram.tableauData (program D) movable

def boundaryData (D : Data (ParserState := ParserState) (UState := UState)
    (UTape := UTape)) :
    PakCouplingGenerated.MachineBoundaryData
      (State ParserState UState) (Tape UTape) :=
  { start := .start
    accept := .accept
    hash := .hash
    zero := .core D.zero
    one := .core D.one
    work := .core D.work
    rightEnd := .scratch ⟨2, by decide⟩ }

theorem program_binary_branching
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) (q : State ParserState UState) (x : Tape UTape) :
    Fintype.card {a : Arrow D // (transition D a).sourceState = q ∧
      (transition D a).read = x} ≤ 2 :=
  arrows_at_source_card_le_two (program D) q x

theorem start_slot_zero
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) {a : UTape} (ha : isInitialLetter D a = true) :
    (program D).rule .start (.core a) 0 = some
      { write := .core a, target := .accept, move := .stay } := by
  simp [program, ha]

theorem start_slot_one
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) {a : UTape} (ha : isInitialLetter D a = true) :
    (program D).rule .start (.core a) 1 = some
      { write := .core a, target := .parser D.parserStart, move := .stay } := by
  simp [program, ha]

theorem start_no_other_letter
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) {a : UTape} (ha : isInitialLetter D a = false)
    (i : Fin 2) :
    (program D).rule .start (.core a) i = none := by
  simp [program, ha]

theorem accept_unique_stay
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) {a : Tape UTape} (ha : a ≠ .hash) :
    (program D).rule .accept a 0 = some
      { write := a, target := .accept, move := .stay } ∧
    (program D).rule .accept a 1 = none := by
  cases a <;> simp_all [program]

theorem reject_unique_stay
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) {a : Tape UTape} (ha : a ≠ .hash) :
    (program D).rule .reject a 0 = some
      { write := a, target := .reject, move := .stay } ∧
    (program D).rule .reject a 1 = none := by
  cases a <;> simp_all [program]

theorem parser_deterministic_slot_one
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) (p : ParserState) (a : Tape UTape) :
    (program D).rule (.parser p) a 1 = none := by
  simp [program]

theorem sim_rule_eq
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) (q : UState) (a : UTape) (i : Fin 2) :
    (program D).rule (.sim q) (.core a) i =
      (D.uProgram.rule q a i).map (mapUAction D) := by
  rfl

theorem sentinel_has_no_rule
    (D : Data (ParserState := ParserState) (UState := UState)
      (UTape := UTape)) (q : State ParserState UState) (i : Fin 2)
    (hnotParser : ∀ p, q ≠ .parser p) :
    (program D).rule q .hash i = none := by
  cases q <;> simp_all [program]

end PakFixedPolyomino.MStarOuterProgram
