import PakFixedPolyomino.HigherBlockTableauConcrete
import Mathlib.Tactic

/-!
# Executable one-tape transition to higher-block tableau compiler

The paper's source machine is a finite one-tape machine.  This module removes
one large source of future hand-written table risk: once its finite arrow list
is supplied, the `theta`, left-neighbour and right-neighbour maps required by
`TableauMachineData` are generated by these definitions.
-/

namespace PakFixedPolyomino.OneTapeTableau

inductive Move where
  | left | stay | right
  deriving DecidableEq, Repr

instance : Fintype Move := Fintype.ofList [.left, .stay, .right] (by
  intro x
  cases x <;> simp)

structure Transition (State Tape : Type*) where
  sourceState : State
  read : Tape
  write : Tape
  targetState : State
  move : Move
  deriving DecidableEq, Repr

def cellLetter {State Tape : Type*} : TableauCell State Tape → Tape
  | .plain a => a
  | .head _ a => a

def sourcePair {State Tape : Type*} (a : Transition State Tape) : State × Tape :=
  (a.sourceState, a.read)

/-- Update a cell whose left neighbour owns the selected arrow. -/
def updateFromLeft {State Tape : Type*} (a : Transition State Tape) :
    TableauCell State Tape → TableauCell State Tape
  | .plain b => if a.move = .right then .head a.targetState b else .plain b
  | .head q b => .head q b

/-- Update a cell whose right neighbour owns the selected arrow. -/
def updateFromRight {State Tape : Type*} (a : Transition State Tape) :
    TableauCell State Tape → TableauCell State Tape
  | .plain b => if a.move = .left then .head a.targetState b else .plain b
  | .head q b => .head q b

/-- Literal three-cell update when the old head is at the centre.  `movable`
is false on sentinel letters, so moves onto sentinels are undefined. -/
def theta {State Tape : Type*} [DecidableEq State] [DecidableEq Tape]
    (movable : Tape → Bool) (a : Transition State Tape)
    (old : CellTriple (TableauCell State Tape)) :
    Option (CellTriple (TableauCell State Tape)) :=
  match old.center with
  | .plain _ => none
  | .head q r =>
      if q ≠ a.sourceState ∨ r ≠ a.read then none
      else
        match a.move, old.minus, old.plus with
        | .stay, _, _ =>
            if movable a.write then some
              { minus := old.minus
                center := .head a.targetState a.write
                plus := old.plus }
            else none
        | .left, .plain l, _ =>
            if movable l then some
              { minus := .head a.targetState l
                center := .plain a.write
                plus := old.plus }
            else none
        | .right, _, .plain rgt =>
            if movable rgt then some
              { minus := old.minus
                center := .plain a.write
                plus := .head a.targetState rgt }
            else none
        | _, _, _ => none

/-- Compile an enumerated arrow alphabet into the exact local maps consumed
by the existing higher-block Wang construction. -/
def tableauMachineData {State Tape Arrow : Type*}
    [DecidableEq State] [DecidableEq Tape]
    (arrow : Arrow → Transition State Tape) (movable : Tape → Bool) :
    TableauMachineData State Tape Arrow where
  source a := sourcePair (arrow a)
  theta a := theta movable (arrow a)
  leftUpdate a := updateFromRight (arrow a)
  rightUpdate a := updateFromLeft (arrow a)

@[simp] theorem tableauMachineData_source
    {State Tape Arrow : Type*} [DecidableEq State] [DecidableEq Tape]
    (arrow : Arrow → Transition State Tape) (movable : Tape → Bool) (a : Arrow) :
    (tableauMachineData arrow movable).source a = sourcePair (arrow a) := rfl

theorem theta_some_forces_source
    {State Tape : Type*} [DecidableEq State] [DecidableEq Tape]
    (movable : Tape → Bool) (a : Transition State Tape)
    (old new : CellTriple (TableauCell State Tape))
    (h : theta movable a old = some new) :
    old.center = .head a.sourceState a.read := by
  cases hc : old.center with
  | plain x => simp [theta, hc] at h
  | head q r =>
      by_cases hbad : q ≠ a.sourceState ∨ r ≠ a.read
      · simp [theta, hc, hbad] at h
      · push Not at hbad
        simp [hbad]

theorem theta_left_target_movable
    {State Tape : Type*} [DecidableEq State] [DecidableEq Tape]
    (movable : Tape → Bool) (a : Transition State Tape)
    (old new : CellTriple (TableauCell State Tape))
    (hm : a.move = .left) (h : theta movable a old = some new) :
    ∃ b, old.minus = .plain b ∧ movable b = true := by
  cases hc : old.center with
  | plain x => simp [theta, hc] at h
  | head q r =>
      by_cases hbad : q ≠ a.sourceState ∨ r ≠ a.read
      · simp [theta, hc, hbad] at h
      · cases hl : old.minus with
        | head ql l => simp [theta, hc, hbad, hm, hl] at h
        | plain l =>
            by_cases hmov : movable l = true
            · exact ⟨l, rfl, hmov⟩
            · have hfalse : movable l = false := Bool.eq_false_of_not_eq_true hmov
              simp [theta, hc, hbad, hm, hl, hfalse] at h

theorem theta_right_target_movable
    {State Tape : Type*} [DecidableEq State] [DecidableEq Tape]
    (movable : Tape → Bool) (a : Transition State Tape)
    (old new : CellTriple (TableauCell State Tape))
    (hm : a.move = .right) (h : theta movable a old = some new) :
    ∃ b, old.plus = .plain b ∧ movable b = true := by
  cases hc : old.center with
  | plain x => simp [theta, hc] at h
  | head q r =>
      by_cases hbad : q ≠ a.sourceState ∨ r ≠ a.read
      · simp [theta, hc, hbad] at h
      · cases hr : old.plus with
        | head qr rgt => simp [theta, hc, hbad, hm, hr] at h
        | plain rgt =>
            by_cases hmov : movable rgt = true
            · exact ⟨rgt, rfl, hmov⟩
            · have hfalse : movable rgt = false := Bool.eq_false_of_not_eq_true hmov
              simp [theta, hc, hbad, hm, hr, hfalse] at h

@[simp] theorem updateFromLeft_plain_right
    {State Tape : Type*} (a : Transition State Tape) (b : Tape)
    (h : a.move = .right) :
    updateFromLeft a (.plain b) = .head a.targetState b := by simp [updateFromLeft, h]

@[simp] theorem updateFromRight_plain_left
    {State Tape : Type*} (a : Transition State Tape) (b : Tape)
    (h : a.move = .left) :
    updateFromRight a (.plain b) = .head a.targetState b := by simp [updateFromRight, h]

end PakFixedPolyomino.OneTapeTableau
